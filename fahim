<style>
:root{
  --bg:#07111f; --bg2:#0b1728; --card:#101d31; --line:rgba(148,163,184,.18);
  --text:#ffffff; --muted:#afbdd2; --blue:#43d8ff; --blue2:#4f7cff; --max:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Poppins',sans-serif;color:var(--text);line-height:1.65;
  background:
    radial-gradient(circle at 10% 8%,rgba(67,216,255,.12),transparent 30%),
    radial-gradient(circle at 90% 20%,rgba(79,124,255,.13),transparent 32%),
    var(--bg);
}
a{text-decoration:none;color:inherit}
.wrap{max-width:var(--max);margin:auto;padding:0 24px}

header{
  position:sticky;top:0;z-index:50;
  background:rgba(7,17,31,.82);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
nav{height:78px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px}
.brand img{width:42px;height:42px;border-radius:11px;object-fit:cover;border:1px solid var(--line)}
.brand-name{font-family:'Poppins',sans-serif;font-weight:700;letter-spacing:-.3px}
.white-name{color:#fff}
.blue-name{color:#43d8ff}

.navlinks{display:flex;gap:25px;color:#c8d3e3;font-size:14px;font-weight:600}
.navlinks a{transition:.2s}
.navlinks a:hover{color:#fff}

.hero{
  min-height:calc(100vh - 78px);padding:90px 0 75px;
  display:grid;grid-template-columns:1.1fr .9fr;gap:58px;align-items:center
}
.kicker{
  display:inline-flex;padding:8px 13px;border:1px solid rgba(67,216,255,.28);
  background:rgba(67,216,255,.07);border-radius:999px;color:#bdefff;
  font-size:12px;font-weight:700;margin-bottom:20px
}
h1{font-size:clamp(45px,7vw,78px);line-height:1.05;letter-spacing:-3.5px}
h1 .blue{color:var(--blue)}
.lead{font-size:18px;color:var(--muted);max-width:690px;margin:24px 0 30px}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{
  display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;
  border-radius:12px;border:1px solid var(--line);font-weight:700;font-size:14px;transition:.2s
}
.btn:hover{transform:translateY(-2px)}
.primary{background:linear-gradient(135deg,var(--blue),#71a4ff);color:#04101c;border:0}

.profile-shell{
  position:relative;display:flex;justify-content:center
}
.profile-ring{
  position:absolute;inset:-10px;border-radius:34px;
  background:linear-gradient(135deg,rgba(67,216,255,.65),rgba(79,124,255,.25),transparent 60%);
  filter:blur(1px);opacity:.65
}
.profile-card{
  position:relative;width:min(410px,100%);padding:12px;border:1px solid var(--line);
  border-radius:34px;background:rgba(12,24,42,.86);box-shadow:0 30px 80px rgba(0,0,0,.38)
}
.profile-photo{
  width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center 25%;
  display:block;border-radius:25px
}
.profile-caption{padding:20px 15px 16px}
.profile-caption h3{font-size:23px;margin-bottom:5px}
.profile-caption p{color:var(--muted);font-size:14px}

section{padding:92px 0;border-top:1px solid rgba(148,163,184,.09)}
.eyebrow{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#7fe7ff;font-weight:800;margin-bottom:9px}
h2{font-size:42px;letter-spacing:-1.3px;margin-bottom:15px}
.about-card{
  margin-top:30px;border:1px solid var(--line);border-radius:22px;
  background:linear-gradient(145deg,rgba(17,31,51,.82),rgba(9,20,36,.73));
  padding:30px
}
.about-card p{color:#c7d3e3;font-size:17px}

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px}
.card{padding:27px;border:1px solid var(--line);background:rgba(16,29,48,.68);border-radius:20px}
.card h3{font-size:18px;margin-bottom:8px}
.card p{color:var(--muted);font-size:14px}
.project{min-height:180px}
.label{font-size:11px;text-transform:uppercase;letter-spacing:1.3px;color:#7fe7ff;font-weight:800;margin-bottom:8px}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px}
.contact-link{display:block;transition:.2s}
.contact-link:hover{transform:translateY(-3px);border-color:rgba(67,216,255,.4)}
.contact-link strong{display:block;font-size:12px;text-transform:uppercase;letter-spacing:1.4px;color:#7fe7ff;margin-bottom:7px}
.contact-link span{font-size:16px;word-break:break-word;color:#edf5ff}

footer{padding:30px 0;text-align:center;color:#8290a7;font-size:13px}

@media(max-width:830px){
  .navlinks{display:none}
  .hero{grid-template-columns:1fr;padding-top:68px}
  .grid,.contact-grid{grid-template-columns:1fr}
  h1{letter-spacing:-2.3px}
  h2{font-size:35px}
  .profile-shell{margin-top:10px}
}

@media (max-width: 830px) {
  .hero {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }
}

</style>
</head>

